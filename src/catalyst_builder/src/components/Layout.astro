---
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { useTranslations, locales, defaultLocale, localePath, type Locale } from '../i18n';
import { urls } from '../data/content';
import { getPackageInfo } from '../data/pub';

interface Props {
  locale: Locale;
  /** Overrides `meta.title`; docs pages pass "<page title> | catalyst_builder". */
  title?: string;
  /** Overrides `meta.description`; docs pages pass their frontmatter description. */
  description?: string;
  /**
   * Path relative to the locale root, e.g. `docs/quickstart/` — pass
   * `docsSubPath(slug)` from a docs page, omit it for a locale landing page.
   */
  path?: string;
}
const { locale, title: pageTitle, description: pageDescription, path } = Astro.props;
const { t } = useTranslations(locale);
const { version, license } = await getPackageInfo();

// Canonical/hreflang URLs are built manually from BASE_URL — getRelativeLocaleUrl
// is unreliable with a non-root `base`. site = Pages domain root,
// base = the path prefix the site is served under (see astro.config.mjs).
const siteRoot = import.meta.env.SITE.replace(/\/$/, '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// hreflang/canonical must be absolute, so prefix the shared base-relative URL
// rather than rebuild it here — keeps it byte-identical to the nav links.
// `path` is appended for docs pages: a docs page is the same document under
// every locale prefix, so without it all 15 would declare the locale root as
// their canonical and cross-declare each other as alternates.
const href = (l: Locale) => `${siteRoot}${localePath(l)}${path ?? ''}`;
const canonical = href(locale);
const isLanding = path === undefined;

const ogLocales: Record<Locale, string> = {
  en: 'en_US',
  de: 'de_DE',
  fr: 'fr_FR',
  it: 'it_IT',
  es: 'es_ES',
};

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareSourceCode',
  name: 'catalyst_builder',
  description: t('meta.description'),
  url: canonical,
  programmingLanguage: 'Dart',
  softwareVersion: version,
  codeRepository: urls.github,
  license: `https://spdx.org/licenses/${license}`,
  sameAs: [urls.pubBuilder, urls.pubContracts],
});
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle ?? t('meta.title')}</title>
    <meta name="description" content={pageDescription || t('meta.description')} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href(defaultLocale)} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle ?? t('meta.title')} />
    <meta property="og:description" content={pageDescription || t('meta.description')} />
    <meta property="og:locale" content={ogLocales[locale]} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle ?? t('meta.title')} />
    <meta name="twitter:description" content={pageDescription || t('meta.description')} />
    {/* Describes the package itself, so it belongs on the landing pages only —
        a docs page is documentation *about* the package, not the thing. */}
    {isLanding && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <slot />
  </body>
</html>
