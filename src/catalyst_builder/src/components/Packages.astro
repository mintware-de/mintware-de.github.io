---
import type { Locale } from '../i18n';
import { useTranslations } from '../i18n';
import { packages } from '../data/content';
import RichText from './RichText.astro';

const { locale } = Astro.props as { locale: Locale };
const { t, dict } = useTranslations(locale);
---
<section class="section">
  <div class="section-inner">
    <div class="section-head">
      <span class="eyebrow">{t('packages.eyebrow')}</span>
      <h2 class="section-h2">{t('packages.title')}</h2>
    </div>
    <div class="card-row">
      {
        packages.map((pkg, i) => {
          const item = dict.packages.items[i];
          const linkText = t('packages.pubLink').replace('{name}', pkg.name);
          return (
            <div class:list={['pkg-card', pkg.accent && 'pkg-card-accent']}>
              <div class="pkg-top">
                <span class="pkg-name">{pkg.name}</span>
                <span class:list={['pkg-badge', !pkg.accent && 'pkg-badge-plain']}>{item.tag}</span>
              </div>
              <p class="pkg-body">
                <RichText text={item.body} />
              </p>
              <a href={pkg.url} class="pkg-link">{linkText}</a>
            </div>
          );
        })
      }
    </div>
  </div>
</section>
