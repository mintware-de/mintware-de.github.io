---
import type { Locale } from '../i18n';
import { useTranslations, localePath, docsPath } from '../i18n';
import { urls, packageName } from '../data/content';
import Logo from './icons/Logo.astro';
import GithubIcon from './icons/GithubIcon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

const { locale, path } = Astro.props as { locale: Locale; path?: string };
const { t } = useTranslations(locale);
const isDocs = path?.startsWith('docs') === true;
---
<header class="site-header">
  <nav aria-label={t('aria.main')} class="nav">
    {/* On a docs page `#top` is an anchor inside the article, not the landing
        page, so the brand has to become a real link once we are off the root. */}
    <a href={isDocs ? localePath(locale) : '#top'} class="brand">
      <Logo width={44} height={30} />
      <span class="brand-name">{packageName}</span>
    </a>
    <div class="nav-links">
      {/* The landing-page anchors only exist on the landing page; from the docs
          they have to point back at it rather than resolve to nothing. */}
      {isDocs ? (
        <a href={`${localePath(locale)}#how`} class="nav-link">{t('nav.how')}</a>
        <a href={`${localePath(locale)}#features`} class="nav-link">{t('nav.features')}</a>
        <a href={`${localePath(locale)}#quickstart`} class="nav-link">{t('nav.quickstart')}</a>
      ) : (
        <>
          <a href="#how" class="nav-link">{t('nav.how')}</a>
          <a href="#features" class="nav-link">{t('nav.features')}</a>
          <a href="#quickstart" class="nav-link">{t('nav.quickstart')}</a>
        </>
      )}
      <a href={docsPath(locale)} class="nav-link" aria-current={isDocs ? 'page' : undefined}>{t('nav.docs')}</a>
      <LanguageSwitcher locale={locale} path={path} />
      <a href={urls.github} class="btn-gh">
        <GithubIcon />
        {t('nav.github')}
      </a>
    </div>
  </nav>
</header>
