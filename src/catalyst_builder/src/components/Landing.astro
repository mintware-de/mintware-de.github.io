---
import type { Locale } from '../i18n';
import Layout from './Layout.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import FactsStrip from './FactsStrip.astro';
import HowItWorks from './HowItWorks.astro';
import Features from './Features.astro';
import Packages from './Packages.astro';
import Quickstart from './Quickstart.astro';
import Cta from './Cta.astro';
import Footer from './Footer.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---
<Layout locale={locale}>
  <Nav locale={locale} />
  <main>
    <Hero locale={locale} />
    <FactsStrip locale={locale} />
    <HowItWorks locale={locale} />
    <Features locale={locale} />
    <Packages locale={locale} />
    <Quickstart locale={locale} />
    <Cta locale={locale} />
  </main>
  <Footer locale={locale} />
</Layout>
